@@ -1,7 +1,36 @@
 def cdp_up():
     try:
         with urllib.request.urlopen(CDP_URL, timeout=3) as r:
             return r.status == 200
     except Exception:
         return False
+def drm_output_statuses():
+    """Return readable DRM connector statuses; missing nodes mean no proof of a display."""
+    paths = set()
+    for pattern in ("/sys/class/drm/card-[A-Z]-*/status", "/sys/class/drm/card*-*/status"):
+        paths.update(glob.glob(pattern))
+    statuses = []
+    for path in sorted(paths):
+        try:
+            with open(path) as f:
+                statuses.append((path, f.read().strip().lower()))
+        except OSError:
+            continue
+    return statuses
+
+def drm_output_connected():
+    return any(status == "connected" for _, status in drm_output_statuses())
+
+def wait_for_connected_drm_output():
+    announced = False
+    while True:
+        if drm_output_connected():
+            if announced:
+                log("connected DRM output detected; resuming kiosk launch")
+            return
+        if not announced:
+            log("no connected DRM output; standing down and polling every 30s")
+            announced = True
+        time.sleep(DRM_POLL_S)
+
 def find_browser_pids():
