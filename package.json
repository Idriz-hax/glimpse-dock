{
  "name": "glimpse-dock",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"tsx server/server.ts\"",
    "dev:server": "tsx server/server.ts",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json && vite build",
    "start": "node start-production.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "concurrently": "9.2.5",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "4.1.12",
    "ws": "8.22.0"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.8",
    "@fastify/websocket": "11.3.4",
    "better-sqlite3": "12.11.1",
    "fastify": "5.12.7",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  }
}
